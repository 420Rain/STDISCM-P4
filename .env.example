# Keep this value the same for every backend service. Change it for any non-demo deployment.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
# Optional: Google OAuth 2.0 Web client ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Default DB host. Change to postgres-standby after manual standby promotion.
DB_HOST=postgres-primary
